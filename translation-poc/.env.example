# Copy to .env and fill in.
GEMINI_API_KEY=your_key_here

# Live model. Default is the dedicated translate model (allowlist preview).
# If `npm run smoke` returns 403 / NOT_FOUND, fall back to: gemini-2.0-flash-live-001
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview

# Bridge ports
BRIDGE_HTTP_PORT=8080        # health + agent WebSocket + serves agent-ui/
AUDIOSOCKET_PORT=9092        # TCP port Asterisk AudioSocket connects to
AGENT_WS_PATH=/agent

# Native Asterisk media: paired caller/agent translation or temporary audio echo test.
# Each connection supplies CALL_ID, ROLE, SOURCE_LANG, TARGET_LANG in
# MEDIA_START.channel_variables (JSON). Languages are per call, not environment defaults.
MEDIA_MODE=translation

# Languages for the browser-agent demo.
AGENT_LANG=hi
CUSTOMER_LANG=en
